[Unit]
Description=MakerMonitor poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=makermonitor
Group=makermonitor
WorkingDirectory=/opt/makermonitor/poller
ExecStart=/opt/makermonitor/poller/.venv/bin/python -m makermonitor
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
