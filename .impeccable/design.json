  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one shadow-paint action on a surface: save, download.",
      "html": "<button class=\"ds-btn ds-btn-pri\">Download CSV</button>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-btn{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:7px 14px;border-radius:9px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:600 14px var(--sans);cursor:pointer}.ds-btn-pri{background:var(--acc);border-color:var(--acc);color:var(--acc-ink)}.ds-btn-pri:hover{filter:brightness(1.08)}.ds-btn:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default action on a panel face.",
      "html": "<button class=\"ds-btn\">Preview</button>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-btn{display:inline-flex;align-items:center;min-height:36px;padding:7px 14px;border-radius:9px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:600 14px var(--sans);cursor:pointer}.ds-btn:hover{border-color:var(--ink3)}.ds-btn:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Sunk field with a shadow-paint focus ring.",
      "html": "<input class=\"ds-in\" placeholder=\"Filter by name\">",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-in{min-height:40px;padding:8px 11px;border-radius:9px;border:1px solid var(--line);background:var(--panel2);color:var(--ink);font:14px var(--sans);outline:none}.ds-in:focus{border-color:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 24%,transparent)}"
    },
    {
      "name": "Band and Folder Tabs",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Hardboard band with tabs cut into the steel ground.",
      "html": "<div class=\"ds-band\"><a class=\"ds-tab on\" href=\"#\">Overview</a><a class=\"ds-tab\" href=\"#\">Models</a><a class=\"ds-tab\" href=\"#\">Activity <span class=\"ds-ct\">30</span></a></div>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-band{display:flex;gap:2px;padding:10px 14px 0;background:var(--hb);font:600 14px var(--sans)}.ds-tab{padding:9px 14px 10px;border-radius:8px 8px 0 0;color:var(--hb-ink2);text-decoration:none}.ds-tab:hover{color:var(--hb-ink);background:color-mix(in srgb,var(--hb-ink) 9%,transparent)}.ds-tab.on{background:var(--bg);color:var(--ink)}.ds-tab:focus-visible{outline:2px solid #fb8c4a;outline-offset:-2px}.ds-ct{font-size:11.5px;padding:1px 7px;border-radius:999px;background:color-mix(in srgb,var(--hb-ink) 16%,transparent);color:var(--hb-ink)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-on",
      "description": "Window or metric switch in a panel header strip.",
      "html": "<span class=\"ds-seg\"><button class=\"on\">Today</button><button>7 days</button><button>Lifetime</button></span>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-seg{display:inline-flex;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:2px}.ds-seg button{border:0;background:none;min-height:30px;padding:4px 11px;border-radius:6px;color:var(--ink2);font:600 13px var(--sans);cursor:pointer}.ds-seg button:hover{color:var(--ink)}.ds-seg button.on{background:var(--panel);color:var(--ink);box-shadow:0 1px 2px rgba(20,25,30,.08),inset 0 0 0 1px var(--line)}.ds-seg button:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Panel with Header Strip",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat hairline panel; title left, time window right.",
      "html": "<div class=\"ds-card\"><h2>Funnel<span></span><small>30 days, and yesterday</small></h2><p>Impressions <b>180,030</b></p></div>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:0 18px 16px;font:14px/1.45 var(--sans);color:var(--ink);font-variant-numeric:tabular-nums}.ds-card h2{display:flex;align-items:center;gap:10px;margin:0 -18px 14px;padding:11px 18px;min-height:48px;border-bottom:1px solid var(--line2);font:650 17px/1.3 var(--sans)}.ds-card h2 span{flex:1}.ds-card h2 small{font:500 12.5px var(--sans);color:var(--ink3)}"
    },
    {
      "name": "Today Board Row",
      "kind": "custom",
      "refersTo": "card",
      "description": "Signature slot: label and count, 24-peg day strip, comparison against yesterday by now.",
      "html": "<div class=\"ds-row\"><div><span class=\"ds-lab\"><i></i>Downloads</span><b>+13</b></div><svg viewBox=\"0 0 120 20\"><circle cx=\"5\" cy=\"9\" r=\"1.3\" fill=\"#d3d8dc\"/><circle cx=\"15\" cy=\"9\" r=\"3.4\" fill=\"#109e6a\"/><circle cx=\"25\" cy=\"9\" r=\"3\" fill=\"none\" stroke=\"#58626c\" stroke-width=\"1.3\"/><circle cx=\"35\" cy=\"9\" r=\"2.4\" fill=\"#109e6a\"/><circle cx=\"45\" cy=\"9\" r=\"1.3\" fill=\"#d3d8dc\"/><circle cx=\"55\" cy=\"9\" r=\"4.2\" fill=\"#109e6a\"/><circle cx=\"55\" cy=\"9\" r=\"4.9\" fill=\"none\" stroke=\"#58626c\" stroke-width=\"1.3\"/><rect x=\"51.5\" y=\"18.2\" width=\"7\" height=\"1.8\" rx=\".9\" fill=\"#c2410c\"/><circle cx=\"65\" cy=\"9\" r=\"3\" fill=\"none\" stroke=\"#58626c\" stroke-width=\"1.3\"/><circle cx=\"75\" cy=\"9\" r=\"1.3\" fill=\"#d3d8dc\"/><circle cx=\"85\" cy=\"9\" r=\"3\" fill=\"none\" stroke=\"#58626c\" stroke-width=\"1.3\"/></svg><div class=\"ds-cmp\"><b>+8</b><br>vs 5 by now yesterday</div></div>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-row{display:grid;grid-template-columns:120px minmax(0,1fr) 150px;gap:18px;align-items:center;padding:10px 0;font:14px var(--sans);color:var(--ink);font-variant-numeric:tabular-nums}.ds-lab{font-size:13px;font-weight:600;color:var(--ink2)}.ds-lab i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--d);margin-right:6px}.ds-row b{display:block;font:700 27px/1.1 var(--sans);letter-spacing:-.01em}.ds-cmp{text-align:right;font-size:12.5px;color:var(--ink3)}.ds-cmp b{display:inline;font-size:14px;color:var(--ok)}"
    },
    {
      "name": "Needs-you Item",
      "kind": "custom",
      "refersTo": "card",
      "description": "Action list entry; the shadow-paint dot is the only orange in the panel.",
      "html": "<ul class=\"ds-acts\"><li><i></i><div><b><a href=\"#\">Reply to 56 comments</a></b><span>Comments on your models with no answer from you yet.</span></div></li><li class=\"fix\"><i></i><div><b>Improve the page for <a href=\"#\">Hand Scanner</a></b><span>962 views in 30 days but 0.6% downloaded.</span></div></li></ul>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-acts{list-style:none;margin:0;padding:0;font:14px var(--sans);color:var(--ink)}.ds-acts li{display:flex;gap:12px;padding:11px 0;border-top:1px solid var(--line2)}.ds-acts li:first-child{border-top:0}.ds-acts i{flex:none;width:10px;height:10px;border-radius:50%;margin-top:5px;background:var(--acc)}.ds-acts li.fix i{background:none;box-shadow:inset 0 0 0 2px var(--acc)}.ds-acts b{display:block;font-weight:650}.ds-acts a{color:inherit}.ds-acts a:hover{color:var(--acc)}.ds-acts span{display:block;color:var(--ink2);font-size:13px;margin-top:2px}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge-ok",
      "description": "Health and source state pill.",
      "html": "<span class=\"ds-badge\"><i></i>All MakerWorld sources OK</span>",
      "css": ":host{--hb:#55402e;--hb-ink:#fbf6ef;--hb-ink2:#e4d6c5;--bg:#e9ecee;--panel:#fff;--panel2:#f3f5f6;--line:#d3d8dc;--line2:#e5e9ec;--ink:#14191e;--ink2:#424c56;--ink3:#58626c;--acc:#c2410c;--acc-ink:#fff;--ok:#07714d;--err:#c42b40;--d:#109e6a;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-badge{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;font:700 12.5px var(--sans);background:color-mix(in srgb,var(--ok) 13%,var(--panel));color:var(--ok)}.ds-badge i{width:7px;height:7px;border-radius:50%;background:currentColor}"
    }
  ],
  "narrative": {
    "northStar": "The Shadow Board",
    "overview": "The dashboard is a workshop pegboard. Every metric keeps a fixed slot and every hour of the day is a peg hole: yesterday's count is the painted outline, today's peg fills it, so a gap or a surplus reads at a glance without a chart legend. A hardboard-brown band with folder tabs sits over a cool galvanized-steel ground, and flat white panels hang on hairlines with a header strip in place of a floating title.\n\nDensity is workbench-dense, not airy: rows of numbers, tables and short sentences, all in one system sans with tabular figures. Colour does two jobs only. The metric colours, shared with the desk panels, are terrain: downloads are always green, likes always pink. Shadow-paint orange marks what needs the creator and the current hour, and nothing else.\n\nThe world refuses the row of identical white stat tiles with sparklines; the Today board is one panel of slotted rows instead.",
    "keyCharacteristics": [
      "Hardboard band, steel ground, flat hairline panels with a 48px header strip.",
      "The 24-peg day strip as the signature mark, reused for best hours.",
      "Fixed metric colours as terrain; one reserved orange for \"needs you\" and \"now\".",
      "One system sans for everything, tabular figures everywhere, 12-hour times.",
      "Light and dark from the OS, no theme switch, no external assets."
    ],
    "rules": [
      {
        "name": "The Shadow-Paint Rule",
        "body": "Orange means \"this needs you\" or \"now\". It never colours a metric, a chart series, a heading or decoration; if an element is not actionable and not the current hour, it is not orange.",
        "section": "colors"
      },
      {
        "name": "The Fixed Slot Rule",
        "body": "A metric's colour is its identity across web, kiosk and desk panels. Never reassign, reorder or reuse a metric hue for status or emphasis.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Every number uses the system sans with tabular figures, set on `body`. Monospace is never used for metrics.",
        "section": "typography"
      },
      {
        "name": "The 12-Hour Rule",
        "body": "Every time the dashboard shows is 12-hour with AM/PM: clock times as \"11:00 AM\", axes as \"12 AM, 6 AM, 12 PM, 6 PM, 11 PM\", ranges as \"9:00 PM-7:00 AM\". No 24-hour time anywhere.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Panels are flat on a 1px hairline. A panel never gets a drop shadow; only floating and modal layers do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give every metric its fixed slot and its fixed colour, the same as the desk panels.",
      "**Do** use the peg strip for anything that is \"per hour of a day\".",
      "**Do** state the time window of every number in the header strip or beside the figure.",
      "**Do** put deltas in status-ok / status-error with a small triangle, and \"even\" in ink when there is no change.",
      "**Do** write every time in 12-hour format with AM/PM.",
      "**Do** keep each new panel flat: 8px, 1px hairline, 48px header strip."
    ],
    "donts": [
      "**Don't** use shadow-paint orange for a metric, a chart series or decoration (The Shadow-Paint Rule).",
      "**Don't** build rows of identical stat tiles with sparklines; put metrics in one slotted panel.",
      "**Don't** add drop shadows to panels, or a second typeface for display or numbers.",
      "**Don't** load fonts, scripts or images from another host; the page is self-contained.",
      "**Don't** add a manual theme toggle; light and dark follow the OS."
    ]
  }
}