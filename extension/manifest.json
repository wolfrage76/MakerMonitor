{
  "manifest_version": 3,
  "name": "MakerMonitor Cookie Courier",
  "version": "0.1.0",
  "description": "Sends MakerWorld session cookies to your local MakerMonitor poller when they change.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MakerMonitor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}